{
  "manifest_version": 3,
  "name": "Meetup Unblur",
  "version": "1.0.0",
  "description": "Removes blur-sm CSS class blurring on meetup.com",
  "permissions": [],
  "content_scripts": [
    {
      "matches": ["*://*.meetup.com/*"],
      "js": ["content.js"],
      "css": ["unblur.css"],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
